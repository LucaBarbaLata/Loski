# Copy this file to `.env` and fill in the values, or leave them empty: Loski
# then asks for them on a setup page at http://127.0.0.1:5588 and saves them
# in data/setup.env itself. Never commit `.env`.

# --- Discord -----------------------------------------------------------------
# Discord Developer Portal -> your "Loski" application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord user ID. Only this account controls Loski (plus any co-DJs).
# Leave it empty to claim Loski instead: DM it "claim" and the code from the
# setup page or the log, and whoever does first becomes the owner.
OWNER_ID=

# --- Spotify Web API (used for search and follow mode) ------------------------
# developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:5588/callback
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Optional ------------------------------------------------------------------
# Port for the one-time Spotify login page (must match the redirect URI above).
# AUTH_PORT=5588

# The next five can also be changed from Discord with /settings, which is
# easier and wins over what's here. These are only the starting values.

# Seconds to wait before leaving when you leave voice or the channel empties.
# LEAVE_AFTER_SECS=60

# Seconds to stay connected after the queue runs out.
# IDLE_LEAVE_SECS=300

# Opus bitrate sent to Discord, in bits per second, or "auto" to match the
# voice channel's own bitrate setting (the highest your server allows).
# AUDIO_BITRATE=auto

# Your timezone, so /stats and the monthly recap know when a day starts.
# Any name from the tz database works. Defaults to UTC.
# TIMEZONE=Europe/Bucharest

# Spotify volume normalisation (like the "Normalize volume" toggle in the app).
# NORMALISE=true

# A new bot gets Loski's own picture, banner and "About me"; whatever you
# change (with /customize, or in Discord's developer portal) stays as you set
# it. BOT_NAME names the bot at startup; a name picked in /customize wins.
# SYNC_PROFILE=false leaves the profile alone.
# BOT_NAME=Loski
# SYNC_PROFILE=true

# Once a day Loski asks GitHub whether a newer release is out and DMs you if
# so. UPDATE_REPO is where releases come from (for forks).
# UPDATE_CHECK=true
# UPDATE_REPO=LucaBarbaLata/Loski

# Talking back with the graphics-card voice (Chatterbox, NVIDIA only): a
# container of its own next to Loski. See INSTALLATION.md.
# COMPOSE_PROFILES=gpu-voice
# Where Loski finds that voice, if not next to it.
# VOICE_SERVER=http://voice:8800

# Log verbosity: error, warn, info, debug, trace
# RUST_LOG=info,loski=debug
