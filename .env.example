# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Discord -----------------------------------------------------------------
# Discord Developer Portal -> your "Loski" application -> Bot -> Reset Token
DISCORD_TOKEN=

# Your Discord user ID. Only this account can control Loski.
OWNER_ID=

# --- Spotify Web API (used for search and follow mode) ------------------------
# developer.spotify.com/dashboard -> Create app
#   Redirect URI: http://127.0.0.1:5588/callback
#   API: Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Optional ------------------------------------------------------------------
# Port for the one-time Spotify login page (must match the redirect URI above).
# AUTH_PORT=5588

# Seconds to wait before leaving when you leave voice or the channel empties.
# LEAVE_AFTER_SECS=60

# Seconds to stay connected after the queue runs out.
# IDLE_LEAVE_SECS=300

# Opus bitrate sent to Discord, in bits per second, or "auto" to match the
# voice channel's own bitrate setting (the highest your server allows).
# AUDIO_BITRATE=auto

# Your timezone, so /stats and the monthly recap know when a day starts.
# Any name from the tz database works. Defaults to UTC.
# TIMEZONE=Europe/Bucharest

# Spotify volume normalisation (like the "Normalize volume" toggle in the app).
# NORMALISE=true

# Loski sets the bot's name, avatar, banner and "About me" from the repo on
# startup. Set SYNC_PROFILE=false to leave the profile alone.
# BOT_NAME=Loski
# SYNC_PROFILE=true

# Log verbosity: error, warn, info, debug, trace
# RUST_LOG=info,loski=debug
